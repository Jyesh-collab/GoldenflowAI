__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.env
*.log

# Phase 0 outputs - baselines are committed deliberately, audits are not
artifacts/audits/
artifacts/scratch/

# Mobile app (Flutter) lives under mobile-app/ - these guard against stray
# generated/leftover copies appearing at repo root, not the tracked content
# under mobile-app/ (anchored with leading "/" so mobile-app/* is unaffected).
/android/
/ios/
/macos/
/windows/
/linux/
/lib/
/assets/
/maestro/
/bagisto-backend/
.dart_tool/
.flutter-plugins-dependencies
.DS_Store

# mobile-app-tests/ (Python + Pytest + Appium test framework) - .venv/,
# __pycache__/, *.log, and .pytest_cache/ above already cover most of its
# generated output; these are the framework-specific extras. No nested
# .gitignore in mobile-app-tests/ - this root file is the single source
# of truth for what stays out of the repo.
/mobile-app-tests/reports/
/mobile-app-tests/logs/
